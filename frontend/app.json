{
  "expo": {
    "name": "Nomue",
    "slug": "nomue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomue",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foun.nomue",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.foun.nomue"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Nomue to use your location to find local Vietnamese dishes."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/bigshoulder/BigShoulders-Black.ttf",
            "./assets/fonts/bigshoulder/BigShoulders_18pt-Black.ttf",
            "./assets/fonts/bigshoulder/BigShoulders_24pt-Black.ttf",
            "./assets/fonts/bigshoulder/BigShoulders_36pt-Black.ttf",
            "./assets/fonts/bigshoulder/BigShoulders_60pt-Black.ttf",
            "./assets/fonts/josefin/JosefinSans-Regular.ttf",
            "./assets/fonts/josefin/JosefinSans-Italic.ttf",
            "./assets/fonts/josefin/JosefinSans-SemiBold.ttf",
            "./assets/fonts/josefin/JosefinSans-SemiBoldItalic.ttf"
          ]
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dba69da9-b4a3-4084-98a1-de3af4b2654b"
      }
    },
    "owner": "foun55"
  }
}
